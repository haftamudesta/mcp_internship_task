generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  role         UserRole      @default(USER)
  orders       Order[]
  reservations Reservation[]
}

model Product {
  id             String         @id @default(uuid())
  name           String
  description    String?
  price          Float
  totalStock     Int
  availableStock Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  inventoryLogs  InventoryLog[]
  orders         Order[]
  reservations   Reservation[]
}

model Reservation {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("ACTIVE")
  order     Order?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status, expiresAt])
}

model Order {
  id            String       @id @default(uuid())
  userId        String
  productId     String
  reservationId String?      @unique
  quantity      Int
  totalAmount   Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  status        String       @default("PENDING")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id         String   @id @default(uuid())
  productId  String
  quantity   Int
  oldStock   Int
  newStock   Int
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())
  changeType String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
  OWNER
}
